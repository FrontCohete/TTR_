# Copia este archivo como .env.development.local para cambiar valores sin tocar el original.
#
# VITE_USE_MOCKS
#   true  -> datos simulados (src/mocks). Útil mientras no exista el backend.
#   false -> backend real (FastAPI). Las llamadas a /api se reenvían a VITE_API_URL.
VITE_USE_MOCKS=true

# Dirección del backend de FastAPI (solo se usa cuando VITE_USE_MOCKS=false)
VITE_API_URL=http://localhost:8000

# Tipo de enrutador: "browser" (rutas limpias, por defecto), "hash" (/#/analizar) o "memory".
# "hash" sirve para publicar la interfaz como archivos estáticos sin servidor;
# "memory" no toca la barra de direcciones (vistas previas incrustadas).
VITE_ROUTER=browser
